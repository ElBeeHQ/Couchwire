<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed: libchiaki needs raw UDP broadcast (discovery, wake) and its own
	     sockets. Developer ID distribution doesn't require the sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Hardened runtime: the microphone for game and party chat. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Ad-hoc signing only: ad-hoc code can't load another ad-hoc framework (Sparkle) under
	     the hardened runtime. Developer ID builds use Couchwire-DeveloperID.entitlements,
	     which leaves library validation on. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
